{
  "name": "@atlas/monorepo",
  "version": "1.0.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Open-source frontend platform for production Next.js applications.",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.js",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/__tests__/*.test.mjs",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:coverage:all": "turbo run test:coverage && node scripts/collect-scripts-coverage.mjs",
    "test:boundaries": "node --test apps/web/eslint.boundaries.test.mjs apps/reference/eslint.boundaries.test.mjs",
    "test:risk-coverage": "pnpm --filter @atlas/web test:coverage && pnpm --filter @atlas/ui test:coverage && node scripts/coverage-policy.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "docs:check:external": "node scripts/check-doc-links.mjs --external",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "api:gen": "pnpm --filter @atlas/web api:gen && pnpm --filter @atlas/reference api:gen",
    "api:check": "pnpm api:gen && git diff --exit-code -- apps/web/src/lib/api/contracts/schema.ts apps/reference/src/lib/api/contracts/schema.ts",
    "template:check": "pnpm exec atlas sync infrastructure --check",
    "template:sync": "pnpm exec atlas sync infrastructure",
    "atlas:resolve-contract": "pnpm --filter @atlas/project resolve",
    "atlas": "pnpm exec atlas",
    "validate:env": "pnpm --filter @atlas/web validate:env && pnpm --filter @atlas/reference validate:env",
    "storybook": "pnpm --filter @atlas/ui storybook",
    "storybook:build": "pnpm --filter @atlas/ui build-storybook",
    "perf:lhci": "pnpm --filter @atlas/web perf:lhci",
    "perf:analyze": "pnpm --filter @atlas/web perf:analyze",
    "perf:enable": "node tools/perf/enable.js",
    "perf:disable": "node tools/perf/disable.js",
    "ci:self-hosted:enable": "node tools/ci-self-hosted/enable.js",
    "ci:self-hosted:disable": "node tools/ci-self-hosted/disable.js",
    "compose:check": "node scripts/validate-compose-security.mjs && docker compose config --quiet && echo '✓ Compose configuration is valid'",
    "compose:sanity": "docker compose --profile sanity up -d && docker compose --profile sanity logs sanity && docker compose --profile sanity down",
    "infra:help": "echo 'Atlas is a pure frontend platform—no infrastructure required.\\n\\nFor consumer apps needing DB/cache:\\n  1. See: examples/compose/infra.yml\\n  2. Docs: docs/how-we-build/local-dev-composition.md\\n  3. Run:  docker compose -f docker-compose.yml -f examples/compose/infra.yml --profile infra up -d'",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/consolidate-atlas-release.mjs",
    "changeset:status": "changeset status",
    "security:check": "node scripts/security-audit.mjs",
    "security:workflow-check": "node scripts/validate-github-workflows.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "governance:check": "node scripts/validate-governance.mjs",
    "dependencies:check": "pnpm turbo build --filter=@blitzcraftlabs/atlas && node scripts/validate-dependencies.mjs",
    "distribution:publish-dry-run": "node scripts/verify-npm-publish-dry-run.mjs",
    "licenses:check": "node scripts/audit-licenses.mjs",
    "licenses:report": "node scripts/audit-licenses.mjs --report",
    "provenance:check": "node scripts/provenance-audit.mjs",
    "provenance:history": "node scripts/provenance-audit.mjs --history",
    "agents:check": "node --test scripts/__tests__/agent-discoverability.test.mjs",
    "docs:validate": "pnpm docs:check && pnpm governance:check",
    "release:rehearse": "node scripts/release-rehearse.mjs",
    "release:publish": "node scripts/publish-atlas-release.mjs",
    "release:publish:dry-run": "node scripts/publish-atlas-release.mjs --dry-run --skip-checks",
    "distribution:verify": "node scripts/verify-distribution-clean-room.mjs",
    "distribution:prepare-publish": "node scripts/prepare-npm-publish.mjs",
    "distribution:publish-npm": "node scripts/publish-npm-package.mjs",
    "distribution:verify-registry": "node scripts/verify-distribution-registry.mjs"
  },
  "devDependencies": {
    "@blitzcraftlabs/atlas": "workspace:*",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@turbo/gen": "2.3.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.10",
    "turbo": "2.3.3",
    "typescript-eslint": "^8.50.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "@xmldom/xmldom": "0.8.15",
      "basic-ftp": "5.3.1",
      "browserslist": "4.28.7",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "fast-uri": "3.1.6",
      "flatted": "3.4.4",
      "form-data": "4.0.6",
      "handlebars": "4.7.9",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "lodash": "4.18.1",
      "minimatch@3": "3.1.5",
      "minimatch@5": "5.1.9",
      "minimatch@9": "9.0.9",
      "path-to-regexp@0.1": "0.1.13",
      "picomatch@2": "2.3.2",
      "postcss": "8.5.26",
      "preact": "10.28.2",
      "rollup": "4.61.1",
      "sharp": "0.35.4",
      "vite": "6.4.3",
      "ws@7": "7.5.13",
      "ws@8": "8.21.3"
    }
  }
}
