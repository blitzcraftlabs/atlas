# ==========================================
# Atlas Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control
#
# Validation: Run `pnpm validate:env` to check your configuration
# Documentation: docs/how-we-build/env.md
#
# Minimum for starter app (/examples routes, same-origin mocked APIs):
#   NODE_ENV, NEXT_PUBLIC_API_URL, NEXT_PUBLIC_APP_URL
# Optional: DATABASE_URL (only for database-backed features)
# Required for OAuth (/api/auth/google/*): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, AUTH_SESSION_SECRET

# ==========================================
# Node Environment
# ==========================================
# Options: development | test | production
NODE_ENV=development

# ==========================================
# Server-Only Variables (Never exposed to client)
# ==========================================
# These are only accessible in API routes, server components, and middleware
# Validated by: apps/web/src/schemas/env/server-runtime-config.ts

# Logging level for server-side logs
# Options: debug | info | warn | error
LOG_LEVEL=info

# Server-side API base URL (optional)
# Used when server needs to make API calls to itself
# API_BASE_URL=/api

# Database connection URL (optional for starter /examples; required in production CI/deploy)
# Example: postgresql://user:password@localhost:5432/atlas_dev
# DATABASE_URL=postgresql://user:password@localhost:5432/atlas

# ==========================================
# Sentry - Error Monitoring (Server-Side)
# ==========================================
# Optional: When not set, Sentry is gracefully disabled
# Get your DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/

# Sentry DSN for server-side error tracking
# SENTRY_DSN=https://YOUR_KEY@oYOUR_ORG.ingest.sentry.io/YOUR_PROJECT

# Sentry environment (defaults to NODE_ENV if not set)
# Options: production | staging | development
# SENTRY_ENVIRONMENT=development

# Sentry release identifier (recommended for production)
# Use git SHA or semantic version
# SENTRY_RELEASE=my-app@1.0.0

# Enable Sentry in development (disabled by default)
# SENTRY_ENABLE_IN_DEV=true

# ==========================================
# Sentry - Sourcemap Upload (CI/CD Only)
# ==========================================
# Only required when uploading sourcemaps in CI/CD builds
# Builds work without these - they just disable sourcemap upload

# Sentry auth token (create at: Sentry → Settings → Auth Tokens)
# Required permissions: project:releases, project:write
# SENTRY_AUTH_TOKEN=your_auth_token_here

# Sentry organization slug
# SENTRY_ORG=your-org-slug

# Sentry project slug
# SENTRY_PROJECT=atlas-web

# ==========================================
# Client-Side Variables (Safe to expose in browser)
# ==========================================
# All variables starting with NEXT_PUBLIC_ are bundled into client code
# Validated by: apps/web/src/schemas/env/public-runtime-config.ts

# Base API URL for client-side requests
# Starter default: /api (same-origin — /examples use app routes under /api/examples/*)
# Real products: replace with your backend API URL (e.g. https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=/api

# Application environment identifier (optional)
# Options: development | staging | production
# NEXT_PUBLIC_APP_ENV=development

# Build ID for version tracking (optional)
# Usually set automatically in CI/CD
# NEXT_PUBLIC_BUILD_ID=

# ==========================================
# Web Vitals - Performance Monitoring (Optional)
# ==========================================

# Enable/disable Web Vitals reporting
# NEXT_PUBLIC_WEB_VITALS_ENABLED=true

# Sample rate for Web Vitals (0-1)
# NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.05

# Custom endpoint for Web Vitals data
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=/api/telemetry/web-vitals

# Debug mode for Web Vitals
# NEXT_PUBLIC_WEB_VITALS_DEBUG=false

# ==========================================
# Sentry - Error Monitoring (Client-Side)
# ==========================================
# Optional: When not set, Sentry is gracefully disabled
# Note: These are PUBLIC and will be visible in browser bundles

# Sentry DSN for client-side error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oYOUR_ORG.ingest.sentry.io/YOUR_PROJECT

# Sentry environment (should match server-side SENTRY_ENVIRONMENT)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Sentry release identifier (should match server-side SENTRY_RELEASE)
# NEXT_PUBLIC_SENTRY_RELEASE=my-app@1.0.0

# Enable Sentry in development (disabled by default)
# NEXT_PUBLIC_SENTRY_ENABLE_IN_DEV=true

# ==========================================
# Optional: Skip Environment Validation
# ==========================================
# Set to 'true' to skip validation (not recommended for production)
# SKIP_ENV_VALIDATION=false

# ==========================================
# Analytics (Optional)
# ==========================================
# When set, analytics adapters are configured. With consent enabled, tracking
# remains denied until the user accepts the analytics category.

# PostHog project API key
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx

# PostHog API host (defaults to https://us.i.posthog.com)
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Log analytics events to the browser console
# NEXT_PUBLIC_ANALYTICS_DEBUG=false

# ==========================================
# Consent Management (Optional)
# ==========================================
# Disabled by default. Set NEXT_PUBLIC_CONSENT_ENABLED=true to show the banner
# and gate analytics until the user opts in.

# NEXT_PUBLIC_CONSENT_ENABLED=false
# NEXT_PUBLIC_CONSENT_MODE=opt-in
# NEXT_PUBLIC_CONSENT_REVISION=1
# NEXT_PUBLIC_PRIVACY_POLICY_URL=/privacy
# NEXT_PUBLIC_COOKIE_POLICY_URL=/cookies
# NEXT_PUBLIC_CONTACT_URL=/contact

# CSP note: consent does not relax CSP. If analytics is enabled, add the
# appropriate script-src/connect-src hosts via CSP_* env vars (see below).

# ==========================================
# Security Configuration
# ==========================================
# See src/lib/security/README.md for CSP and security header configuration

# Enable HSTS (Strict-Transport-Security)
# Only enable in production when HTTPS is guaranteed
# WARNING: This commits your domain to HTTPS - cannot easily undo
# ENABLE_HSTS=true

# CSP mode: off | report-only | enforce
# Default: off (CSP is opt-in — set explicitly to enable)
# Use report-only to audit violations without blocking, enforce to harden production.
# CSP_MODE=off

# CSP violation reporting endpoint (optional)
# CSP_REPORT_URI=/api/csp-report

# Additional allowed script sources (comma-separated)
# Example: Google Analytics, CDN
# CSP_SCRIPT_SRC=https://www.googletagmanager.com,https://cdn.example.com

# Additional allowed connect sources (comma-separated)
# Example: API endpoints, analytics
# CSP_CONNECT_SRC=https://api.example.com,https://analytics.example.com

# Additional allowed image sources (comma-separated)
# CSP_IMG_SRC=https://cdn.example.com,https://images.example.com

# Additional allowed font sources (comma-separated)
# CSP_FONT_SRC=https://fonts.googleapis.com,https://fonts.gstatic.com

# Additional allowed style sources (comma-separated)
# CSP_STYLE_SRC=https://fonts.googleapis.com

# Allowed frame sources for embedded content (comma-separated)
# CSP_FRAME_SRC=https://www.youtube.com,https://player.vimeo.com

# Allowed frame ancestors (domains that can embed this app)
# Default: 'none' (no embedding allowed)
# WARNING: Only allow trusted domains - opens clickjacking risk
# CSP_FRAME_ANCESTORS=https://trusted-partner.com

# ==========================================
# OAuth / Authentication
# ==========================================
# Required for OAuth authentication (Google, etc.)
# See docs/adr/0004-oauth-google-pkce.md for setup instructions

# Google OAuth Client ID
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client Secret
# Keep this secret secure - never commit real values
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Generic OpenID Connect (Auth0, Okta, Entra ID, Keycloak, Zitadel, ...) — /api/auth/oidc/*
# Redirect URI to register with the issuer: <NEXT_PUBLIC_APP_URL>/api/auth/oidc/callback
# AUTH_OIDC_ISSUER=https://your-tenant.example.com
# AUTH_OIDC_CLIENT_ID=your-oidc-client-id
# AUTH_OIDC_CLIENT_SECRET=your-oidc-client-secret
# AUTH_OIDC_SCOPES="openid email profile offline_access"

# Session encryption secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
AUTH_SESSION_SECRET=your-32-character-secret-key-here-replace-me

# Session TTL in seconds (default: 604800 = 7 days)
# AUTH_SESSION_TTL_SECONDS=604800

# ==========================================
# Reference harness (local development only)
# ==========================================
# Deterministic auth/API without Google OAuth or external services.
# See docs/how-we-build/reference-harness.md
#
# The reference harness runs in apps/reference — not in the starter app.
# To run the reference application:
#   pnpm --filter @atlas/reference dev
#
# Application URL (used for OAuth callbacks)
# Required for OAuth redirect URIs
NEXT_PUBLIC_APP_URL=http://localhost:3000
