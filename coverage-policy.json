{
  "reports": [
    { "id": "web", "path": "apps/web/coverage/coverage-final.json" },
    { "id": "ui", "path": "packages/ui/coverage/coverage-final.json" },
    { "id": "cli", "path": "packages/cli/coverage/coverage-final.json" },
    { "id": "scripts", "path": "coverage/scripts/lcov.info", "format": "lcov" }
  ],
  "subsystems": [
    {
      "id": "web-auth",
      "report": "web",
      "include": ["**/apps/web/src/lib/auth/**", "**/apps/web/src/app/api/auth/**"],
      "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/providers/google.ts",
        "**/useSession.ts",
        "**/lib/auth/server.ts"
      ],
      "thresholds": { "statements": 85, "lines": 85, "branches": 75, "functions": 85 }
    },
    {
      "id": "web-api",
      "report": "web",
      "include": ["**/apps/web/src/lib/api/**"],
      "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/contracts/schema.ts"],
      "thresholds": { "statements": 85, "lines": 85, "branches": 75, "functions": 85 }
    },
    {
      "id": "ui-form-infrastructure",
      "report": "ui",
      "include": [
        "**/packages/ui/src/components/forms/**",
        "**/packages/ui/src/hooks/use-zod-form.ts",
        "**/packages/ui/src/lib/forms/**"
      ],
      "exclude": ["**/*.example.ts", "**/*.example.tsx", "**/*.test.ts", "**/*.test.tsx"],
      "thresholds": { "statements": 80, "lines": 80, "branches": 70, "functions": 80 }
    },
    {
      "id": "ui-owned-behavior",
      "report": "ui",
      "include": [
        "**/packages/ui/src/components/ui/button.tsx",
        "**/packages/ui/src/components/ui/select.tsx",
        "**/packages/ui/src/components/ui/dialog.tsx",
        "**/packages/ui/src/components/ui/tooltip.tsx",
        "**/packages/ui/src/components/ui/error-fallback.tsx",
        "**/packages/ui/src/components/ui/empty-state.tsx",
        "**/packages/ui/src/components/ui/switch.tsx",
        "**/packages/ui/src/hooks/use-theme.ts",
        "**/packages/ui/src/lib/theme-boot-script.ts"
      ],
      "exclude": ["**/*.test.ts", "**/*.test.tsx"],
      "thresholds": { "statements": 80, "lines": 80, "branches": 70, "functions": 80 }
    },
    {
      "id": "cli-upgrade",
      "report": "cli",
      "include": ["**/packages/cli/src/upgrade/**", "**/packages/cli/src/commands/upgrade.ts"],
      "exclude": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/upgrade/build-release-assets-main.ts",
        "**/upgrade/published-catalog-verifier.ts"
      ],
      "thresholds": { "statements": 86, "lines": 86, "branches": 71, "functions": 88 }
    },
    {
      "id": "cli-template-sync",
      "report": "cli",
      "include": ["**/packages/cli/src/template-sync/**", "**/packages/cli/src/commands/sync.ts"],
      "exclude": ["**/__tests__/**", "**/*.test.ts"],
      "thresholds": { "statements": 80, "lines": 80, "branches": 61, "functions": 86 }
    },
    {
      "id": "cli-init",
      "report": "cli",
      "include": [
        "**/packages/cli/src/init/**",
        "**/packages/cli/src/bootstrap/**",
        "**/packages/cli/src/commands/init.ts"
      ],
      "exclude": ["**/__tests__/**", "**/*.test.ts"],
      "thresholds": { "statements": 83, "lines": 83, "branches": 60, "functions": 91 }
    },
    {
      "id": "scripts-release",
      "report": "scripts",
      "include": [
        "scripts/publish-atlas-release.mjs",
        "scripts/publish-npm-package.mjs",
        "scripts/release-publication.mjs",
        "scripts/finalize-atlas-release.mjs",
        "scripts/consolidate-atlas-release.mjs",
        "scripts/root-release-changelog.mjs",
        "scripts/validate-governance.mjs",
        "scripts/check-release-consistency.mjs",
        "scripts/extract-changelog-section.mjs",
        "scripts/lib/release-consistency.mjs",
        "scripts/lib/release-github-state.mjs",
        "scripts/lib/npm-publication.mjs",
        "scripts/lib/npm-publish-dry-run.mjs"
      ],
      "requireFiles": [
        "scripts/publish-atlas-release.mjs",
        "scripts/publish-npm-package.mjs",
        "scripts/release-publication.mjs",
        "scripts/finalize-atlas-release.mjs",
        "scripts/consolidate-atlas-release.mjs",
        "scripts/root-release-changelog.mjs",
        "scripts/validate-governance.mjs",
        "scripts/check-release-consistency.mjs",
        "scripts/extract-changelog-section.mjs",
        "scripts/lib/release-consistency.mjs",
        "scripts/lib/release-github-state.mjs",
        "scripts/lib/npm-publication.mjs",
        "scripts/lib/npm-publish-dry-run.mjs"
      ],
      "thresholds": { "lines": 79, "branches": 70, "functions": 82 }
    }
  ]
}
