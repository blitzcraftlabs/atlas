{
  "name": "@atlas/project",
  "version": "1.2.3",
  "private": true,
  "license": "Apache-2.0",
  "description": "Atlas project architecture contract schema and loader",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=json --coverageReporters=lcov",
    "test:watch": "jest --watch",
    "resolve": "tsx scripts/resolve-contract.ts",
    "capture-baseline": "node scripts/capture-platform-baseline.mjs",
    "clean": "rm -rf .turbo node_modules coverage dist"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@atlas/config": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.50.0"
  }
}
