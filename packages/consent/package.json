{
  "name": "@atlas/consent",
  "version": "1.3.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Optional cookie consent management for Atlas apps",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=json --coverageReporters=lcov",
    "test:watch": "jest --watch",
    "clean": "rm -rf .turbo node_modules coverage"
  },
  "dependencies": {
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@atlas/config": "workspace:*",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.17.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.50.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
