{
  "name": "@atlas/ui",
  "version": "1.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Atlas design system built on shadcn Base UI primitives",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./extended": "./src/extended.ts",
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./styles": "./src/styles/globals.css",
    "./theme": "./src/lib/theme.ts",
    "./theme-boot": "./src/lib/theme-boot-script.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=json",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "node scripts/run-storybook-tests.mjs",
    "test:storybook:cross-browser": "playwright test -c playwright.storybook.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "test:visual:docker": "node scripts/run-visual-in-playwright-docker.mjs",
    "test:ui-quality": "pnpm build-storybook && pnpm test:storybook && pnpm test:storybook:cross-browser && pnpm test:visual",
    "clean": "rm -rf .turbo node_modules coverage storybook-static",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^4.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.561.0",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.68.0",
    "react-resizable-panels": "^4.0.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.18.0",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@atlas/config": "workspace:*",
    "@jest/globals": "29.7.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-onboarding": "8.6.18",
    "@storybook/addon-themes": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@storybook/test-runner": "0.23.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-playwright": "^2.2.2",
    "eslint": "9.17.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "8.5.26",
    "prettier": "3.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "storybook": "8.6.18",
    "tailwindcss": "4.1.18",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.50.0",
    "vite": "6.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
