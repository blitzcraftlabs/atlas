# Dependencies
# Docker matches `node_modules` only at the context root. Nested workspace
# folders must be ignored too so COPY . . cannot overlay host installs onto
# the cached pnpm dependency layer.
node_modules
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store

# Testing
coverage
**/coverage
.nyc_output

# Next.js / build artifacts
.next
**/.next
out
dist
**/dist
build
.turbo
**/.turbo

# Production
*.tsbuildinfo

# Misc
.DS_Store
*.pem

# Debug
*.log

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Git
.git
.gitignore
.gitattributes

# Docker
Dockerfile*
docker-compose*
.dockerignore

# CI/CD
.github
.gitlab-ci.yml

# Documentation
README.md
LICENSE
docs

# Tests
# Unanchored `test` / `e2e` only match the context root. Nested app test
# helpers must stay out of COPY . . so `next build` does not typecheck them.
test
tests
src/test
**/src/test
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
e2e
**/e2e
playwright-report
test-results
