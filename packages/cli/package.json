{
  "name": "@blitzcraftlabs/atlas",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "description": "Source-owned frontend platform CLI for Next.js — bootstrap, diagnose, generate, inspect, and upgrade Atlas applications.",
  "keywords": [
    "atlas",
    "nextjs",
    "react",
    "typescript",
    "frontend",
    "platform",
    "cli",
    "scaffolding",
    "codegen",
    "architecture",
    "pnpm"
  ],
  "bin": {
    "atlas": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./dependency-validation": "./dist/dependency-validation.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets/bootstrap/manifest.json",
    "assets/bootstrap/files/**",
    "assets/capabilities/manifest.json",
    "assets/capabilities/files/**",
    "assets/releases/catalog.json",
    "assets/releases/**"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blitzcraftlabs/atlas.git",
    "directory": "packages/cli"
  },
  "homepage": "https://shipwithatlas.com",
  "bugs": {
    "url": "https://github.com/blitzcraftlabs/atlas/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/ensure-atlas-project-built.mjs && rm -rf dist assets && tsc -p tsconfig.build.json && node scripts/bundle-cli.mjs",
    "build:bootstrap": "node scripts/build-bootstrap-assets.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && jest",
    "test:coverage": "pnpm build && jest --coverage --coverageReporters=text --coverageReporters=json --coverageReporters=lcov",
    "test:watch": "jest --watch",
    "clean": "rm -rf .turbo node_modules coverage dist LICENSE THIRD_PARTY_NOTICES.md assets scripts/.cache"
  },
  "dependencies": {
    "minimatch": "10.2.5",
    "typescript": "5.7.2",
    "yaml": "2.5.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@atlas/config": "workspace:*",
    "@atlas/project": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "esbuild": "0.28.2",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "29.2.5",
    "typescript-eslint": "^8.50.0"
  }
}
